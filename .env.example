GM_HOST=127.0.0.1
# Railway and most PaaS set PORT, which wins over GM_PORT.
GM_PORT=8000
# Private-beta gate. Unset = open (local dev). Set in production; never commit a real value.
# GM_ACCESS_TOKEN=
# Comma-separated cross-origin callers (local Vite dev by default). "none" in production.
# GM_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_URL=postgres://gm:gm@localhost:5432/gm
REDIS_URL=redis://localhost:6379/0
RUST_LOG=gm_api=info,gm_worker=info,gm_persistence=info,gm_domain=info,tower_http=info
# Leave unset to use deterministic local test-mode payment keys.
# RAZORPAY_KEY_ID=rzp_test_local
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
